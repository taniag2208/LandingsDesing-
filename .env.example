# ---------------------------------------------------------------------------
# TITA Landing Studio — variables de entorno
# Copia a .env.local. NUNCA subas valores reales al repositorio.
# ---------------------------------------------------------------------------

# URL pública de la app (se usa para enlaces de confirmación e invitación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (local: `npx supabase status -o env`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Solo servidor. Fase 1 no la usa en runtime; se reserva para jobs/webhooks (Fases 4+).
SUPABASE_SECRET_KEY=<secret-key>

# --- Fases posteriores (estructura definida, aún sin uso) ---
# AI_PROVIDER_API_KEY=            # Fase 2: motor de generación IA
# SHOPIFY_APP_CLIENT_ID=          # Fase 4
# SHOPIFY_APP_CLIENT_SECRET=      # Fase 4
# VTEX_APP_KEY_ENCRYPTION_KEY=    # Fase 5: cifrado de credenciales VTEX
# CREDENTIALS_ENCRYPTION_KEY=     # Fase 4/5: cifrado en reposo de tokens de tienda
